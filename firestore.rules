rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything under a user's own tree is private to that user: transactions,
    // payments and customers all live here.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Public statement snapshots. Anyone holding the token can read exactly one
    // customer's open bills; only the owning agent can create or replace it.
    match /statements/{token} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == request.resource.data.ownerUid;
    }

    // Customer name -> token lookup, private to the agent.
    //
    // The rule matches on the `ownerUid` field rather than the document id: a
    // list query can only be authorised when the constraint it filters on is
    // visible to the rules engine, and `docId.split()` is not.
    match /statementIndex/{docId} {
      // A single-document read may target a document that does not exist yet,
      // where `resource` is null and field access would fail; the id prefix is
      // enough to prove ownership there. A list query still needs the field.
      allow get: if request.auth != null
                 && docId.split('__')[0] == request.auth.uid;
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // A customer may only *declare* a payment. It is never counted until the
    // agent confirms it, so a forged claim cannot change a balance.
    match /paymentClaims/{claimId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && exists(/databases/$(database)/documents/statements/$(request.resource.data.token));
      allow read, update: if request.auth != null
                          && request.auth.uid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
