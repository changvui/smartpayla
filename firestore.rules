rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything under a user's own tree is private to that user: transactions,
    // payments and customers all live here.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Public statement snapshots, addressed by an unguessable token.
    //
    // `get` is public because the customer opens the link without an account.
    // `list` is denied: without it, a collection scan would enumerate every
    // customer's statement, which is the one thing the token is meant to prevent.
    match /statements/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.ownerUid;
      // On delete request.resource is null, so ownership is read from the
      // document being removed.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // What the customer says they paid, readable by anyone holding the token.
    //
    // A claim under /paymentClaims is readable only by the agent, because a
    // visitor has no identity a rule could check. This subcollection is the
    // public half: it carries the same amount and bill ids, so the statement
    // page on any device can show "waiting for the agent". The write is limited
    // to a pending declaration against an existing statement - the customer can
    // never set a status or touch a balance - and to the five known fields.
    match /statements/{token}/declarations/{declarationId} {
      allow get, list: if true;
      allow create: if request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['amount', 'billIds', 'claimId', 'status', 'at'])
                    && exists(/databases/$(database)/documents/statements/$(token));
      // The agent clears the notice once the money is on the ledger.
      allow delete: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/statements/$(token)).data.ownerUid;
      allow update: if false;
    }

    // Customer name -> token lookup, private to the agent.
    //
    // The rule matches on the `ownerUid` field rather than the document id: a
    // list query can only be authorised when the constraint it filters on is
    // visible to the rules engine, and `docId.split()` is not.
    match /statementIndex/{docId} {
      // A single-document read may target a document that does not exist yet,
      // where `resource` is null and field access would fail; the id prefix is
      // enough to prove ownership there. A list query still needs the field.
      allow get: if request.auth != null
                 && docId.split('__')[0] == request.auth.uid;
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // A customer may only *declare* a payment. It is never counted until the
    // agent confirms it, so a forged claim cannot change a balance.
    //
    // The owner is not trusted from the request: it is read from the statement
    // the claim points at, so a visitor cannot push claims into another agent's
    // queue by writing a different ownerUid.
    match /paymentClaims/{claimId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.token is string
                    && request.resource.data.ownerUid
                       == get(/databases/$(database)/documents/statements/$(request.resource.data.token)).data.ownerUid;
      allow read, update: if request.auth != null
                          && request.auth.uid == resource.data.ownerUid;
      allow delete: if false;
    }
  }
}
