rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // 1. The agent's own tree: transactions, payments, customers, settings.
    //
    // {document=**} matches every subcollection at any depth, so one rule
    // covers users/{uid}/transactions/x, users/{uid}/payments/y and so on.
    // Anything not matched by an allow rule below is denied.
    // ---------------------------------------------------------------------
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // 2. Published statements, addressed by an unguessable token.
    //
    // get vs list matters here more than anywhere else in the file:
    //   get  = ".doc(token).get()"        - the caller already knows the token
    //   list = ".collection().get()"      - the caller scans the collection
    // Writing "allow read" would grant both, and a scan would return every
    // customer's statement. That is exactly what the token is meant to stop,
    // so the two verbs are separated deliberately.
    // ---------------------------------------------------------------------
    match /statements/{token} {
      allow get: if true;
      allow list: if false;

      // request.resource is the document as it will be after the write, so the
      // owner field cannot be changed to somebody else. The agent may only
      // publish under their own uid.
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.ownerUid;

      // A delete request carries no request.resource (it is null), so ownership
      // has to be read from the document being removed. Using request.resource
      // here fails every time, which is a common and silent mistake.
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // ---------------------------------------------------------------------
    // 3. What the customer says they paid - the public half of a claim.
    //
    // /paymentClaims is readable only by the agent, because a visitor has no
    // identity a rule could check against. This subcollection sits under the
    // token, so "anyone with the link" is the access condition: the same
    // condition as the statement itself. It lets one phone declare a transfer
    // and another phone show "waiting for the agent" without the agent online.
    // ---------------------------------------------------------------------
    match /statements/{token}/declarations/{declarationId} {
      allow get, list: if true;

      // Four checks, each closing a specific hole:
      //   amount is number   - no strings, no negative numbers
      //   status == pending  - the customer can never declare "confirmed"
      //   hasOnly([...])     - no extra fields, so a declaration cannot be
      //                        shaped into something the agent trusts more
      //   exists(statement)  - no declarations against deleted statements
      allow create: if request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(
                         ['amount', 'billIds', 'claimId', 'status', 'at'])
                    && exists(/databases/$(database)/documents/statements/$(token));

      // Only the agent may clear the notice, and only after confirming the
      // money. get() reads the parent statement inside the rule; it counts as
      // one document read per evaluation.
      allow delete: if request.auth != null
                    && request.auth.uid == get(/databases/$(database)/documents/statements/$(token)).data.ownerUid;

      // A declaration is immutable: to change one, delete it (agent only) and
      // declare again. This keeps every entry append-only and auditable.
      allow update: if false;
    }

    // ---------------------------------------------------------------------
    // 4. Customer name -> token lookup, private to the agent.
    //
    // The document id is "<ownerUid>__<customer-key>". Two verbs again:
    //   get  - the document may not exist yet, so resource is null and reading
    //          a field would throw; the id prefix proves ownership instead.
    //   list - the field is available, and it is the same fact the query
    //          filters on, so the rule reads it directly.
    // ---------------------------------------------------------------------
    match /statementIndex/{docId} {
      allow get: if request.auth != null
                 && docId.split('__')[0] == request.auth.uid;
      allow list: if request.auth != null
                  && request.auth.uid == resource.data.ownerUid;
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.ownerUid;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerUid;
    }

    // ---------------------------------------------------------------------
    // 5. A customer may only *declare* a payment.
    //
    // Nothing here changes a balance: a claim becomes money only when the agent
    // confirms it and writes a payment entry. So the worst a forged claim can
    // do is appear in the agent's queue - which is why the owner field is not
    // taken from the request. It is read from the statement the claim points
    // at, otherwise a visitor could address a claim to another agent's queue.
    // ---------------------------------------------------------------------
    match /paymentClaims/{claimId} {
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.token is string
                    && request.resource.data.ownerUid
                       == get(/databases/$(database)/documents/statements/$(request.resource.data.token)).data.ownerUid;

      // Only the owning agent can read the queue or confirm a claim.
      allow read, update: if request.auth != null
                          && request.auth.uid == resource.data.ownerUid;

      // Claims are never deleted: confirmation changes the status, so the
      // request a customer made stays visible in the record.
      allow delete: if false;
    }

    // Cost note for the report: each get()/exists() above is charged as one
    // document read per evaluation, so a declaration costs the statement read
    // plus the claim write. Well inside the free tier for a demonstration.
  }
}
